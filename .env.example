# Copiá este archivo a .env y completá los valores. El .env real no se commitea.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chacra

# Firma la cookie de sesión. El valor de abajo es solo un ejemplo: sirve para desarrollo.
# Generá uno propio (64 caracteres hexadecimales) con:
#   openssl rand -hex 32                                                        (Git Bash, Linux, macOS)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"    (PowerShell)
# Cambiarlo cierra todas las sesiones abiertas y vacía los carritos.
SESSION_SECRET=cambiar-esto

# Con NODE_ENV=production el servidor se niega a arrancar si SESSION_SECRET está vacío,
# es un valor de ejemplo ("dev", "cambiar-esto") o tiene menos de 32 caracteres.
# NODE_ENV=production
