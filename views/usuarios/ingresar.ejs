<%- include('../parciales/cabecera', { titulo: 'Ingresar', clase: 'centrada' }) %>
<section class="acceso">
  <h1>Ingresar</h1>
  <p class="acceso-sub">Entrá con tu usuario para comprar o vender.</p>
  <form method="post">
    <%- campoCsrf() %>
    <input type="hidden" name="sig" value="<%= sig %>">
    <% if (error) { %><p class="err" role="alert"><%= error %></p><% } %>
    <div class="campo"><label for="u">Usuario</label><input id="u" name="usuario" autocomplete="username" required></div>
    <div class="campo"><label for="c">Clave</label><input id="c" name="clave" type="password" autocomplete="current-password" required></div>
    <button class="btn amplio bloque">Ingresar</button>
  </form>
  <p class="acceso-alt">¿Todavía no tenés cuenta? <a href="/registro">Crear una cuenta</a></p>
  <p class="acceso-demo">Para la demo: <b>don_ramon</b> (productor), <b>laura</b> (compradora), clave <b>demo1234</b>. Administrador: <b>admin</b> / <b>admin1234</b>.</p>
</section>
<%- include('../parciales/pie') %>
