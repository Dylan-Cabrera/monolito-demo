<%- include('../parciales/cabecera', { titulo: 'Inicio', clase: 'con-escena', extraHead: include('../parciales/escena_head') }) %>
<div class="lienzo cielo" id="lienzo" aria-hidden="true"></div>
<section class="portada lateral"><div class="wrap">
  <h1>Canto de Hornero</h1>
  <p class="lema">Que tu producción se escuche.</p>
  <p>Del monte formoseño a tu mesa. Productores del interior venden directo, sin intermediarios, y ponen su propio precio.</p>
  <div class="pulso">
    <div><b><%= pulso.productores %></b>productores</div>
    <div><b><%= pulso.localidades %></b>localidades</div>
    <div><b><%= pulso.productos %></b>productos publicados</div>
    <div><b><%= pesos(pulso.vendido) %></b>directo al productor</div>
  </div>
  <%# "/" es la entrada a la presentación; "/inicio" es la misma portada dentro de la app y no vuelve a la guía %>
  <div class="fila"><% if (modo === 'presentacion') { %><a class="btn" href="/arquitectura">Ver la presentación</a><% } else { %><a class="btn" href="/productos">Ver productos</a><% } %></div>
</div></section>
<script type="module" nonce="<%= nonce %>">
  import { crearHornero, hayWebGL } from '/js/hornero.js';
  if (hayWebGL()) crearHornero(document.getElementById('lienzo'));
</script>
<%- include('../parciales/pie') %>
