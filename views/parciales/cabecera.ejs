<% const fijo = typeof temaFijo !== 'undefined' ? temaFijo : null; -%>
<% const pres = modo === 'presentacion'; // portada y guía: sin navegación de la app -%>
<!doctype html>
<html lang="es" data-tema="<%= fijo || 'oscuro' %>"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<% if (!fijo) { %><script nonce="<%= nonce %>">try{if(localStorage.getItem('tema')==='claro'){document.documentElement.dataset.tema='claro';document.documentElement.style.colorScheme='light'}}catch(e){}</script><% } %>
<title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %>Canto de Hornero</title>
<link rel="icon" type="image/png" href="/img/favicon.png">
<link rel="stylesheet" href="/css/app.css">
<% if (!fijo) { %><script src="/js/tema.js" defer></script><% } %>
<% if (typeof extraHead !== 'undefined') { %><%- extraHead %><% } %>
</head><body class="<%= typeof clase !== 'undefined' ? clase : '' %>">
<header class="top"><div class="wrap">
  <a class="marca" href="<%= pres ? '/arquitectura' : '/productos' %>"><img src="/img/escudo-formosa.png" alt="Escudo de la Provincia de Formosa" width="40" height="38">Canto de Hornero</a>
  <% if (!pres || !fijo) { %>
  <nav aria-label="Principal">
    <% if (!pres) { %>
    <% const a = (h) => ruta === h || (h !== '/' && ruta.startsWith(h)) ? 'activo' : ''; %>
    <a class="<%= a('/inicio') %>" href="/inicio">Inicio</a>
    <a class="<%= a('/productos') %>" href="/productos">Productos</a>
    <% if (usuario) { %>
      <% if (usuario.rol === 'PRODUCTOR') { %>
        <a class="<%= a('/panel/productos') %>" href="/panel/productos">Mis productos</a>
        <a class="<%= a('/panel/ventas') %>" href="/panel/ventas">Mis ventas</a>
        <a class="<%= a('/panel/resumen') %>" href="/panel/resumen">Resumen</a>
      <% } else { %><a class="<%= a('/mis-compras') %>" href="/mis-compras">Mis compras</a><% } %>
      <% if (usuario.rol === 'ADMIN') { %><a class="<%= a('/tablero') %>" href="/tablero">Tablero</a><% } %>
    <% } %>
    <a class="<%= a('/carrito') %>" href="/carrito">Carrito (<%= carritoCantidad %>)</a>
    <% if (usuario) { %>
      <form method="post" action="/salir" style="display:inline"><%- campoCsrf() %><button>Salir (<%= usuario.usuario %>)</button></form>
    <% } else { %><a class="<%= a('/ingresar') %>" href="/ingresar">Ingresar</a><% } %>
    <% } %>
    <% if (!fijo) { %>
    <button type="button" class="tema" id="tema" aria-pressed="false" aria-label="Tema claro" title="Cambiar entre tema claro y oscuro">
      <svg class="sol" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
      <svg class="luna" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 14.6A8.4 8.4 0 0 1 9.4 3.8a8.4 8.4 0 1 0 10.8 10.8z"/></svg>
    </button>
    <% } %>
  </nav>
  <% } %>
</div></header>
<main><div class="wrap">
<% if (flash.length) { %><ul class="flash" role="status"><% flash.forEach(f => { %><li class="<%= f.tipo %>"><%= f.texto %></li><% }) %></ul><% } %>
